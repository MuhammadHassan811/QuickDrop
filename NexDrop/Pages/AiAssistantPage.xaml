<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuickDrop.Pages.AiAssistantPage"
             BackgroundColor="#f7f9fb"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             x:Name="AssistantPageRoot">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- 1. HEADER & BOT BİLGİSİ -->
        <Border Grid.Row="0" BackgroundColor="#ffffff" StrokeThickness="0" Padding="16,10,16,10" ZIndex="10">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,1" Opacity="0.04" Radius="8"/>
            </Border.Shadow>
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                    <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" BackgroundColor="#f7f9fb" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="&#xe5c4;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="24" TextColor="#191c1e" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Grid.Column="1" Text="QuickBot AI" FontSize="18" FontAttributes="Bold" TextColor="#191c1e" HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Border Grid.Column="2" WidthRequest="40" HeightRequest="40" BackgroundColor="#f7f9fb" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnClearChatTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="&#xe8ba;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="22" TextColor="#575e70" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <Border BackgroundColor="#f2f4f6" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12,8">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                        <Grid Grid.Column="0" WidthRequest="40" HeightRequest="40">
                            <Image Source="bot_icon.png" Aspect="AspectFit"/>
                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#f97316" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,2,2"/>
                        </Grid>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="QuickBot AI" FontSize="14" FontAttributes="Bold" TextColor="#191c1e"/>
                                <Border BackgroundColor="#fdba74" StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="4,2">
                                    <Label Text="PRO" FontSize="9" FontAttributes="Bold" TextColor="#9a3412"/>
                                </Border>
                            </HorizontalStackLayout>
                            <Label Text="Online • Super-Fast Grocery Assistant" FontSize="11" TextColor="#575e70"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Border>

        <!-- 2. SOHBET ALANI -->
        <CollectionView Grid.Row="1" x:Name="ChatCollectionView" ItemsSource="{Binding ChatMessages}" Margin="16,16,16,24">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="16" Margin="0,0,0,16">
                    <Border BackgroundColor="#ffffff" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="16">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Opacity="0.05" Radius="8"/>
                        </Border.Shadow>
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                            <Image Grid.Column="0" Source="bot_icon.png" WidthRequest="48" HeightRequest="48" Aspect="AspectFit" VerticalOptions="Start"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{Binding WelcomeTitle}" FontSize="18" FontAttributes="Bold" TextColor="#191c1e"/>
                                    <Label Text="👋" FontSize="18" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                        <Label Text="What can I prepare for you today? A dinner recipe, weekly grocery basket, or fresh deals can be added to your cart with a single tap." FontSize="14" TextColor="#575e70" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="8" RowSpacing="8">
                        <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#ffffff" StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="#e0e3e5" Padding="12">
                            <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SendQuickPromptCommand}" CommandParameter="Quick dinner for 4"/>
                            </Border.GestureRecognizers>
                            <Label Text="🥘 Quick dinner for 4" FontSize="12" TextColor="#191c1e" VerticalOptions="Center" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#ffffff" StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="#e0e3e5" Padding="12">
                            <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SendQuickPromptCommand}" CommandParameter="Healthy diet breakfast basket"/>
                            </Border.GestureRecognizers>
                            <Label Text="🥗 Healthy diet breakfast" FontSize="12" TextColor="#191c1e" VerticalOptions="Center" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#ffffff" StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="#e0e3e5" Padding="12">
                            <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SendQuickPromptCommand}" CommandParameter="Snacks under $20"/>
                            </Border.GestureRecognizers>
                            <Label Text="🍿 Snacks under $20" FontSize="12" TextColor="#191c1e" VerticalOptions="Center" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#ffffff" StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="#e0e3e5" Padding="12">
                            <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SendQuickPromptCommand}" CommandParameter="Fresh fruit and vegetable deals"/>
                            </Border.GestureRecognizers>
                            <Label Text="🍎 Fresh fruits &amp; veggies" FontSize="12" TextColor="#191c1e" VerticalOptions="Center" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Spacing="16" Margin="0,0,0,16">

                        <!-- KULLANICI MESAJI -->
                        <Grid IsVisible="{Binding IsUser}" HorizontalOptions="End" Margin="40,0,0,0">
                            <Border BackgroundColor="#ea580c" StrokeShape="RoundRectangle 16,16,4,16" StrokeThickness="0" Padding="16,12">
                                <Border.Shadow>
                                    <Shadow Brush="#ea580c" Offset="0,2" Opacity="0.2" Radius="6"/>
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Text}" FontSize="14" TextColor="#ffffff" LineBreakMode="WordWrap"/>
                                    <Label Text="{Binding Time}" FontSize="10" TextColor="#94a3b8" HorizontalOptions="End"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- BOT MESAJI -->
                        <Grid IsVisible="{Binding IsBot}" HorizontalOptions="Start" Margin="0,0,20,0">
                            <VerticalStackLayout Spacing="8">
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Image Source="bot_icon.png" WidthRequest="24" HeightRequest="24" Aspect="AspectFit"/>
                                    <Label Text="QuickBot AI" FontSize="11" FontAttributes="Bold" TextColor="#575e70" VerticalOptions="Center"/>
                                    <Label Text="{Binding Time}" FontSize="11" TextColor="#cbd5e1" VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <Border BackgroundColor="#ffffff" StrokeShape="RoundRectangle 4,16,16,16" StrokeThickness="0" Padding="16">
                                    <Border.Shadow>
                                        <Shadow Brush="#000000" Offset="0,2" Opacity="0.05" Radius="8"/>
                                    </Border.Shadow>
                                    <VerticalStackLayout Spacing="12">
                                        <Label Text="{Binding Text}" FontSize="14" TextColor="#191c1e" LineBreakMode="WordWrap" LineHeight="1.4"/>

                                        <CollectionView ItemsSource="{Binding DisplayProducts}" IsVisible="{Binding HasProducts}" HeightRequest="215" Margin="-8,8,-16,0">
                                            <CollectionView.ItemsLayout>
                                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12"/>
                                            </CollectionView.ItemsLayout>
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border WidthRequest="155" BackgroundColor="#f7f9fb" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12">
                                                        <VerticalStackLayout Spacing="6">
                                                            <Border BackgroundColor="#ffffff" HeightRequest="100" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="4">
                                                                <Image Source="{Binding MainImage}" Aspect="AspectFit"/>
                                                            </Border>
                                                            <VerticalStackLayout Spacing="0">
                                                                <Label Text="{Binding Name}" FontSize="12" FontAttributes="Bold" TextColor="#191c1e" LineBreakMode="TailTruncation" MaxLines="1"/>
                                                                <Label Text="{Binding Unit}" FontSize="10" TextColor="#575e70" Margin="0,2,0,0"/>
                                                            </VerticalStackLayout>

                                                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="End" Margin="0,8,0,0">
                                                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="-2">
                                                                    <Label Text="{Binding FormattedPrice}" FontSize="14" FontAttributes="Bold" TextColor="#191c1e" LineBreakMode="NoWrap"/>
                                                                </VerticalStackLayout>

                                                                <Grid Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End">
                                                                    <Border WidthRequest="32" HeightRequest="32" BackgroundColor="#f97316" StrokeShape="RoundRectangle 16" StrokeThickness="0" IsVisible="{Binding IsNotInCart}">
                                                                        <Border.GestureRecognizers>
                                                                            <TapGestureRecognizer Command="{Binding BindingContext.AddToCartCommand, Source={x:Reference AssistantPageRoot}}" CommandParameter="{Binding .}"/>
                                                                        </Border.GestureRecognizers>
                                                                        <Label Text="&#xe145;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="18" TextColor="#ffffff" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                                    </Border>

                                                                    <Border BackgroundColor="#f97316" HeightRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0" IsVisible="{Binding IsInCart}">
                                                                        <HorizontalStackLayout Spacing="6" Padding="6,0" VerticalOptions="Center">
                                                                            <Label Text="&#xe15b;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="14" TextColor="#ffffff" VerticalOptions="Center">
                                                                                <Label.GestureRecognizers>
                                                                                    <TapGestureRecognizer Command="{Binding BindingContext.DecreaseCartCommand, Source={x:Reference AssistantPageRoot}}" CommandParameter="{Binding .}"/>
                                                                                </Label.GestureRecognizers>
                                                                            </Label>
                                                                            <Label Text="{Binding CartQuantity}" FontSize="12" FontAttributes="Bold" TextColor="#ffffff" VerticalOptions="Center" Margin="1,0"/>
                                                                            <Label Text="&#xe145;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="14" TextColor="#ffffff" VerticalOptions="Center">
                                                                                <Label.GestureRecognizers>
                                                                                    <TapGestureRecognizer Command="{Binding BindingContext.AddToCartCommand, Source={x:Reference AssistantPageRoot}}" CommandParameter="{Binding .}"/>
                                                                                </Label.GestureRecognizers>
                                                                            </Label>
                                                                        </HorizontalStackLayout>
                                                                    </Border>
                                                                </Grid>
                                                            </Grid>
                                                        </VerticalStackLayout>
                                                    </Border>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>

                                        <Border BackgroundColor="#F5F6FA" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12" IsVisible="{Binding HasChefTip}" Margin="0,4,0,0">
                                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                                <Label Grid.Column="0" Text="&#xe0f0;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="20" TextColor="#008080" VerticalOptions="Start" Margin="0,2,0,0"/>
                                                <Label Grid.Column="1" Text="{Binding ChefTip}" FontSize="12" TextColor="#575e70" LineBreakMode="WordWrap" VerticalOptions="Center"/>
                                            </Grid>
                                        </Border>

                                        <Border BackgroundColor="#ea580c" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16,12" IsVisible="{Binding HasProducts}" Margin="0,8,0,0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.AddAllToCartCommand, Source={x:Reference AssistantPageRoot}}" CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                                    <Label Text="&#xe8cb;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="18" TextColor="#ffffff" VerticalOptions="Center"/>
                                    <Label Text="Add All to Cart" FontSize="13" FontAttributes="Bold" TextColor="#ffffff" VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                                <Border Grid.Column="1" BackgroundColor="#244A36" StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="6,4">
                                                    <Label Text="{Binding FormattedTotalPrice}" FontSize="11" FontAttributes="Bold" TextColor="#fdba74"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <HorizontalStackLayout x:Name="TypingIndicator" Spacing="8" Margin="0,0,0,16" IsVisible="False">
                    <BoxView x:Name="Dot1" WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#f97316"/>
                    <BoxView x:Name="Dot2" WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#f97316"/>
                    <BoxView x:Name="Dot3" WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#f97316"/>
                        <Label Text="QuickBot is preparing the recipe..." FontSize="11" TextColor="#575e70" VerticalOptions="Center" Margin="4,0,0,0"/>
                </HorizontalStackLayout>
            </CollectionView.Footer>
        </CollectionView>

        <!-- 3. MESAJ GİRİŞ ALANI -->
        <Border Grid.Row="2" BackgroundColor="#ffffff" StrokeThickness="0" Padding="16,12,16,24">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-2" Opacity="0.05" Radius="12"/>
            </Border.Shadow>
            <Border BackgroundColor="#f2f4f6" StrokeShape="RoundRectangle 24" StrokeThickness="0" Padding="4">
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" BackgroundColor="Transparent" StrokeThickness="0">
                        <Label Text="&#xe31b;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="22" TextColor="#575e70" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Entry x:Name="MessageEntry" Grid.Column="1" Placeholder="Tell QuickBot what you need..." FontSize="14" TextColor="#191c1e" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    <Border Grid.Column="2" WidthRequest="40" HeightRequest="40" BackgroundColor="#ea580c" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSendMessageTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="&#xe5d8;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="20" TextColor="#ffffff" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</ContentPage>