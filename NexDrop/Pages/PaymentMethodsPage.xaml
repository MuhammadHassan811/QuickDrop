<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuickDrop.Pages.PaymentMethodsPage"
             Title="Payment Methods"
             BackgroundColor="#f7f9fb"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- 1. ÜST BİLGİ ÇUBUĞU (HEADER) -->
        <Grid Grid.Row="0" HeightRequest="60" Padding="16,0" BackgroundColor="#ffffff" VerticalOptions="Start" ZIndex="10" HorizontalOptions="Fill">
            <Grid.Shadow>
                <Shadow Brush="#000000" Opacity="0.04" Offset="0,1" Radius="8"/>
            </Grid.Shadow>
            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center" HorizontalOptions="Fill">
                <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" BackgroundColor="#f7f9fb" StrokeShape="RoundRectangle 20" StrokeThickness="0" VerticalOptions="Center" Margin="-6,0,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Border.GestureRecognizers>
                    <Label Text="&#xe5c4;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="24" TextColor="#191c1e" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Label Grid.Column="1" Text="Payment Methods" FontSize="20" FontAttributes="Bold" TextColor="#191c1e" HorizontalOptions="Center" VerticalOptions="Center"/>
                <BoxView Grid.Column="2" WidthRequest="40" Color="Transparent" />
            </Grid>
        </Grid>

        <!-- 2. ANA İÇERİK VE SEPET ŞERİDİ -->
        <Grid Grid.Row="1">
            <ScrollView Padding="16,16,16,85">
                <VerticalStackLayout Spacing="24" HorizontalOptions="Fill">

                    <!-- Security Trust Marker -->
                    <Grid ColumnDefinitions="*, Auto" BackgroundColor="#f2f4f6" Padding="16,8" VerticalOptions="Center" HorizontalOptions="Fill">
                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                            <Label Text="&#xe8e8;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="18" TextColor="#ea580c" VerticalOptions="Center"/>
                            <Label Text="Secure 256-Bit SSL Encryption" FontSize="11" TextColor="#575e70" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="#ffffff" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="8,2" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3" Color="#f97316" VerticalOptions="Center"/>
                                <Label Text="Aktif Koruma" FontSize="10" TextColor="#ea580c" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <!-- QuickDrop Wallet -->
                    <Border BackgroundColor="#0F2B1D" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="20" HorizontalOptions="Fill">
                        <Border.Shadow>
                            <Shadow Brush="#111827" Offset="0,8" Opacity="0.15" Radius="20"/>
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*, Auto">
                                <HorizontalStackLayout Grid.Column="0" Spacing="12" VerticalOptions="Center">
                                    <Border WidthRequest="40" HeightRequest="40" BackgroundColor="#1F422E" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                        <Label Text="&#xe850;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="20" TextColor="#fdba74" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="QuickDrop Wallet" FontSize="16" FontAttributes="Bold" TextColor="#ffffff" CharacterSpacing="0.5"/>
                                <Label Text="Digital Loyalty Account" FontSize="10" TextColor="#94a3b8"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                                <Border Grid.Column="1" BackgroundColor="#f97316" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="8,4" VerticalOptions="Start">
                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <Label Text="&#xea0b;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="14" TextColor="#ffffff" VerticalOptions="Center"/>
                                    <Label Text="5% Cashback" FontSize="12" FontAttributes="Bold" TextColor="#ffffff" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <Border BackgroundColor="#1A3827" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16">
                                <VerticalStackLayout>
                                <Label Text="Available QuickPoints" FontSize="12" TextColor="#94a3b8"/>
                                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="End" Margin="0,4,0,0">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="End">
                                            <Label Text="{Binding TotalSpentAmount, StringFormat='${0:N2}'}" FontSize="32" FontAttributes="Bold" TextColor="#ffffff"/>
                                            <Label Text="POINTS" FontSize="10" FontAttributes="Bold" TextColor="#fdba74" Margin="0,0,0,6"/>
                                        </HorizontalStackLayout>
                                        <Label Grid.Column="1" Text="1 Point = $1.00" FontSize="10" TextColor="#8C9E94" VerticalOptions="Center"/>
                                    </Grid>
                                    <HorizontalStackLayout Spacing="4" Margin="0,8,0,0">
                                        <Label Text="&#xe8d0;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="14" TextColor="#fdba74" VerticalOptions="Center"/>
                                <Label Text="Earn 5% QuickPoints on every order, spend instantly!" FontSize="10" TextColor="#94a3b8" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                <Button Grid.Column="0" Text="Add Balance" BackgroundColor="#f97316" TextColor="#ffffff" CornerRadius="12" HeightRequest="44" FontAttributes="Bold" FontSize="14"/>
                                <Button Grid.Column="1" Text="Use Points" BackgroundColor="#244A36" TextColor="#ffffff" CornerRadius="12" HeightRequest="44" FontAttributes="Bold" FontSize="14"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Kayıtlı Kredi Kartları -->
                    <VerticalStackLayout Spacing="16" HorizontalOptions="Fill">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                <Label Text="&#xe870;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="20" TextColor="#ea580c" VerticalOptions="Center"/>
                                <Label Text="Saved Cards" FontSize="18" FontAttributes="Bold" TextColor="#191c1e" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#e0e3e5" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="8,4">
                                <Label Text="{Binding CardsCount, StringFormat='{0} Cards'}" FontSize="11" TextColor="#575e70"/>
                            </Border>
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding PaymentMethods}" Spacing="16" HorizontalOptions="Fill">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#ffffff" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="16" HorizontalOptions="Fill">
                                        <Border.Shadow>
                                            <Shadow Brush="#111827" Offset="0,4" Opacity="0.05" Radius="16"/>
                                        </Border.Shadow>
                                        <VerticalStackLayout Spacing="16">
                                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                                <Border Grid.Column="0" WidthRequest="44" HeightRequest="32" BackgroundColor="#f2f4f6" StrokeShape="RoundRectangle 8" StrokeThickness="0" VerticalOptions="Start">
                                                    <Grid WidthRequest="24" HeightRequest="16" BackgroundColor="#FCE68E" HorizontalOptions="Center" VerticalOptions="Center">
                                                        <BoxView WidthRequest="1" Color="#D9B738" HorizontalOptions="Center"/>
                                                        <BoxView HeightRequest="1" Color="#D9B738" VerticalOptions="Center"/>
                                                    </Grid>
                                                </Border>

                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                        <Label Text="{Binding CardName}" FontSize="16" FontAttributes="Bold" TextColor="#191c1e"/>
                                                        <Border BackgroundColor="#fff7ed" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="6,2" IsVisible="{Binding IsDefault}">
                                                            <Label Text="Default" FontSize="10" FontAttributes="Bold" TextColor="#ea580c"/>
                                                        </Border>
                                                    </HorizontalStackLayout>
                                                    <Label Text="{Binding MaskedNumber}" FontSize="12" TextColor="#575e70"/>
                                                </VerticalStackLayout>

                                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                                    <HorizontalStackLayout Spacing="-6" VerticalOptions="Center" IsVisible="{Binding IsMastercard}">
                                                        <BoxView WidthRequest="24" HeightRequest="24" CornerRadius="12" Color="#EB001B" Opacity="0.9"/>
                                                        <BoxView WidthRequest="24" HeightRequest="24" CornerRadius="12" Color="#F79E1B" Opacity="0.9"/>
                                                    </HorizontalStackLayout>
                                                    <Label Text="VISA" FontFamily="Arial" FontAttributes="Bold,Italic" FontSize="24" TextColor="#1A1F71" VerticalOptions="Center" IsVisible="{Binding IsVisa}"/>
                                                </VerticalStackLayout>
                                            </Grid>

                                            <Border BackgroundColor="#f2f4f6" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16,12">
                                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                                    <VerticalStackLayout Grid.Column="0">
                                                        <Label Text="Expires" FontSize="10" TextColor="#575e70"/>
                                                        <Label Text="{Binding ExpiryDate}" FontSize="14" FontAttributes="Bold" TextColor="#191c1e"/>
                                                    </VerticalStackLayout>
                                                    <HorizontalStackLayout Grid.Column="1" Spacing="16" VerticalOptions="Center">
                                                        <Label Text="Set as Default" FontSize="12" FontAttributes="Bold" TextColor="#f97316" VerticalOptions="Center" IsVisible="{Binding IsDefault, Converter={StaticResource InvertedBoolConverter}}">
                                                            <Label.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnMakeDefaultCardTapped"/>
                                                            </Label.GestureRecognizers>
                                                        </Label>

                                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center" IsVisible="{Binding IsDefault}">
                                                            <Label Text="&#xe3c9;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="16" TextColor="#575e70"/>
                                                            <Label Text="Edit" FontSize="12" TextColor="#575e70"/>
                                                            <HorizontalStackLayout.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnEditCardTapped"/>
                                                            </HorizontalStackLayout.GestureRecognizers>
                                                        </HorizontalStackLayout>

                                                        <Label Text="&#xe872;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="20" TextColor="#575e70" VerticalOptions="Center">
                                                            <Label.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnDeleteCardTapped"/>
                                                            </Label.GestureRecognizers>
                                                        </Label>
                                                    </HorizontalStackLayout>
                                                </Grid>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Yemek Kartları -->
                    <VerticalStackLayout Spacing="16" HorizontalOptions="Fill">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                <Label Text="&#xe56c;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="20" TextColor="#FF6A00" VerticalOptions="Center"/>
                                <Label Text="Meal Cards" FontSize="18" FontAttributes="Bold" TextColor="#191c1e" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#e0e3e5" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="8,4">
                                <Label Text="Coupon / Prepaid" FontSize="11" TextColor="#575e70"/>
                            </Border>
                        </Grid>

                        <Border BackgroundColor="#ffffff" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="16" HorizontalOptions="Fill">
                            <Border.Shadow>
                                <Shadow Brush="#111827" Offset="0,4" Opacity="0.05" Radius="16"/>
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="16">
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                    <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" BackgroundColor="#FFF0E6" StrokeShape="RoundRectangle 12" StrokeThickness="0" VerticalOptions="Center">
                                        <Label Text="&#xe57a;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="22" TextColor="#FF6A00" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Label Text="Pluxee / Sodexo" FontSize="16" FontAttributes="Bold" TextColor="#191c1e"/>
                                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#f97316" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                <Label Text="Restaurant Card •••• 5512" FontSize="12" TextColor="#575e70"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center">
                                <Label Text="Current Balance" FontSize="10" TextColor="#575e70" HorizontalOptions="End"/>
                                        <Label Text="$420.00" FontSize="16" FontAttributes="Bold" TextColor="#ea580c" HorizontalOptions="End"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <Border BackgroundColor="#f2f4f6" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12">
                                    <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center">
                                        <Label Grid.Column="0" Text="Supported Cards:" FontSize="10" TextColor="#575e70" VerticalOptions="Center" Margin="0,0,12,0"/>
                                        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                            <Border BackgroundColor="#ffffff" StrokeShape="RoundRectangle 4" StrokeThickness="0" Padding="8,4">
                                                <Label Text="Multinet" FontSize="10" FontAttributes="Bold" TextColor="#575e70"/>
                                            </Border>
                                            <Border BackgroundColor="#ffffff" StrokeShape="RoundRectangle 4" StrokeThickness="0" Padding="8,4">
                                                <Label Text="Ticket Edenred" FontSize="10" FontAttributes="Bold" TextColor="#575e70"/>
                                            </Border>
                                            <Border BackgroundColor="#ffffff" StrokeShape="RoundRectangle 4" StrokeThickness="0" Padding="8,4">
                                                <Label Text="Metropol" FontSize="10" FontAttributes="Bold" TextColor="#575e70"/>
                                            </Border>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Hızlı Mobil & Kapıda Ödeme -->
                    <VerticalStackLayout Spacing="16" HorizontalOptions="Fill">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="&#xe32c;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="20" TextColor="#ea580c" VerticalOptions="Center"/>
                        <Label Text="Fast Mobile &amp; Cash on Delivery" FontSize="18" FontAttributes="Bold" TextColor="#191c1e" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Border BackgroundColor="#ffffff" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="16" HorizontalOptions="Fill">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16" VerticalOptions="Center">
                                <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" BackgroundColor="#f2f4f6" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                    <Label Text="&#xe90d;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="24" TextColor="#191c1e" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Apple Pay / Google Pay" FontSize="16" FontAttributes="Bold" TextColor="#191c1e"/>
                                <Label Text="Confirm instantly with fast &amp; biometric Face ID" FontSize="12" TextColor="#575e70" LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                                <CheckBox Grid.Column="2" IsChecked="True" Color="#f97316" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <Border BackgroundColor="#ffffff" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="16" HorizontalOptions="Fill">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16" VerticalOptions="Center">
                                <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" BackgroundColor="#f2f4f6" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                    <Label Text="&#xe8cc;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="24" TextColor="#191c1e" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Credit / Debit Card at Door" FontSize="16" FontAttributes="Bold" TextColor="#191c1e"/>
                                <Label Text="Pay courier securely with contactless POS terminal" FontSize="12" TextColor="#575e70" LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                                <RadioButton Grid.Column="2" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Yeni Kart Ekle & Güvenlik Paneli -->
                    <VerticalStackLayout Spacing="16" HorizontalOptions="Fill">
                        <Border BackgroundColor="#ffffff" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="0" HeightRequest="56">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAddCardTapped"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                                <Border WidthRequest="32" HeightRequest="32" BackgroundColor="#fff7ed" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                                    <Label Text="&#xe145;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="20" TextColor="#f97316" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Text="Add New Card" FontSize="16" FontAttributes="Bold" TextColor="#ea580c" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                        <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center" HorizontalOptions="Center" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="SECURE INFRASTRUCTURE:" FontSize="10" FontAttributes="Bold" TextColor="#191c1e" VerticalOptions="Center"/>
                            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <Border BackgroundColor="#e0e3e5" StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="6,2">
                                    <HorizontalStackLayout Spacing="4">
                                        <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#EB001B" VerticalOptions="Center"/>
                                        <Label Text="Masterpass" FontSize="10" FontAttributes="Bold" TextColor="#575e70"/>
                                    </HorizontalStackLayout>
                                </Border>
                                <Border BackgroundColor="#e0e3e5" StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="6,2">
                                    <Label Text="BKM Express" FontSize="10" FontAttributes="Bold" TextColor="#575e70"/>
                                </Border>
                                <Border BackgroundColor="#e0e3e5" StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="6,2">
                                    <Label Text="Troy" FontSize="10" FontAttributes="Bold" TextColor="#575e70"/>
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>

                        <Border BackgroundColor="#f2f4f6" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="16" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="&#xe8e8;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="24" TextColor="#ea580c" VerticalOptions="Start"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="PCI-DSS Level 1 &amp; Regulatory Compliance" FontSize="12" FontAttributes="Bold" TextColor="#191c1e"/>
                            <Label Text="Your card details are never stored on QuickDrop servers. All transactions are tokenized and protected by PCI-DSS standards." FontSize="12" TextColor="#575e70" LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <!-- SABİT SEPET ÖZETİ ŞERİDİ -->
            <Border BackgroundColor="#ea580c" HeightRequest="56" Margin="16,0,16,16" StrokeShape="RoundRectangle 28" StrokeThickness="0" IsVisible="{Binding HasCartItems}" VerticalOptions="End">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNavCartTapped"/>
                </Border.GestureRecognizers>
                <Border.Shadow>
                    <Shadow Brush="#ea580c" Offset="0,4" Opacity="0.20" Radius="12" />
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Fill" Padding="6,0,6,0">

                    <Border Grid.Column="0" BackgroundColor="#f97316" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" StrokeThickness="0" VerticalOptions="Center">
                        <Label Text="{Binding UniqueCartItemCount}" FontSize="16" FontAttributes="Bold" TextColor="#ffffff" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0" Margin="0,-2,0,0">
                        <Label Text="Cart Total" FontSize="10" TextColor="#FED7AA" Margin="0,0,0,1"/>
                        <Label Text="{Binding TotalCartText}" FontSize="16" FontAttributes="Bold" TextColor="#ffffff" />
                    </VerticalStackLayout>

                    <Border Grid.Column="2" BackgroundColor="#ffffff" HeightRequest="38" Padding="14,0" StrokeShape="RoundRectangle 19" StrokeThickness="0" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="Go to Cart" FontSize="13" FontAttributes="Bold" TextColor="#ea580c" VerticalOptions="Center" />
                            <Label Text="&#xe5c8;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="18" FontAttributes="Bold" TextColor="#ea580c" VerticalOptions="Center" Margin="0,1,0,0" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Border>

        </Grid>

        <!-- 3. ALT MENÜ ÇUBUĞU (SABİT NAVBAR) -->
        <Border Grid.Row="2" BackgroundColor="#ffffff" HeightRequest="60" StrokeThickness="0" StrokeShape="Rectangle">
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.05" Offset="0,-2" Radius="8"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*,*,*,*,*" Padding="0,4">
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavHomeTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#xe88a;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="24" TextColor="#575e70" HorizontalOptions="Center"/>
                    <Label Text="Home" FontSize="10" TextColor="#575e70" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavCategoriesTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#xe8b6;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="24" TextColor="#575e70" HorizontalOptions="Center"/>
                    <Label Text="Categories" FontSize="10" TextColor="#575e70" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <Grid Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavCartTapped"/>
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="&#xe8cb;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="24" TextColor="#575e70" HorizontalOptions="Center"/>
                        <Label Text="Cart" FontSize="10" TextColor="#575e70" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <!-- SEPET VE BİLDİRİM ROZETİ -->
                    <Border BackgroundColor="#f97316" WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 8" StrokeThickness="0" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-4,-10,0" IsVisible="{Binding HasCartItems}">
                        <Label Text="{Binding UniqueCartItemCount}" FontSize="9" FontAttributes="Bold" TextColor="#ffffff" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavOrdersTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#xEF6E;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="24" TextColor="#575e70" HorizontalOptions="Center"/>
                    <Label Text="Orders" FontSize="10" TextColor="#575e70" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- PROFIL KISMINDA AKTİF RENK -->
                <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavProfileTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#xe7fd;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="24" TextColor="#f97316" HorizontalOptions="Center"/>
                    <Label Text="Profile" FontSize="10" FontAttributes="Bold" TextColor="#f97316" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>
</ContentPage>