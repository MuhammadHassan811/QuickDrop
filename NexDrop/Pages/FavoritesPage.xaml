<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuickDrop.Pages.FavoritesPage"
             Title="Favorite Products"
             BackgroundColor="#f7f9fb"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- 1. HEADER -->
        <Grid Grid.Row="0" HeightRequest="60" Padding="16,0" BackgroundColor="#ffffff" VerticalOptions="Start" ZIndex="10" HorizontalOptions="Fill">
            <Grid.Shadow>
                <Shadow Brush="#000000" Opacity="0.04" Offset="0,1" Radius="8"/>
            </Grid.Shadow>
            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center" HorizontalOptions="Fill">
                <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" BackgroundColor="#f7f9fb" StrokeShape="RoundRectangle 20" StrokeThickness="0" VerticalOptions="Center" Margin="-6,0,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Border.GestureRecognizers>
                    <Label Text="&#xe5c4;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="24" TextColor="#191c1e" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Label Grid.Column="1" Text="My Favorites" FontSize="20" FontAttributes="Bold" TextColor="#191c1e" HorizontalOptions="Center" VerticalOptions="Center"/>
                <BoxView Grid.Column="2" WidthRequest="40" Color="Transparent" />
            </Grid>
        </Grid>

        <!-- 2. MAIN CONTENT AND CART BAR -->
        <Grid Grid.Row="1">

            <CollectionView ItemsSource="{Binding Products}" Margin="0,0,0,85" BackgroundColor="Transparent">
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="0">

                        <!-- SEARCH AND DYNAMIC CATEGORIES -->
                        <VerticalStackLayout Spacing="16" Padding="16,12,16,16" BackgroundColor="#ffffff">
                            <Border BackgroundColor="#f2f4f6" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12,0" HeightRequest="44">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Label Grid.Column="0" Text="&#xe8b6;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="20" TextColor="#575e70" VerticalOptions="Center"/>
                                    <!-- Dynamic Search -->
                                    <Entry x:Name="SearchEntry" Grid.Column="1" Placeholder="Search in favorites..." FontSize="14" TextColor="#191c1e" BackgroundColor="Transparent" ClearButtonVisibility="WhileEditing" Margin="8,0,0,0" TextChanged="OnSearchTextChanged"/>
                                </Grid>
                            </Border>

                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="-16,0">
                                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Categories}" Spacing="8" Padding="16,0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border BackgroundColor="{Binding BackgroundColor}" StrokeShape="RoundRectangle 20" StrokeThickness="{Binding BorderThickness}" Stroke="#e0e3e5" Padding="16,8">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}" FontSize="12" FontAttributes="Bold" TextColor="{Binding TextColor}"/>
                                                    <Label Text="{Binding Count, StringFormat='({0})'}" FontSize="10" FontAttributes="Bold" TextColor="{Binding CountColor}" Opacity="{Binding CountOpacity}"/>
                                                </HorizontalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </ScrollView>
                        </VerticalStackLayout>

                        <!-- DYNAMIC TOTAL AMOUNT SECTION -->
                        <Border BackgroundColor="#ffffff" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="16" Margin="16,16,16,16">
                            <Border.Shadow>
                                <Shadow Brush="#000000" Opacity="0.05" Offset="0,4" Radius="12"/>
                            </Border.Shadow>
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <HorizontalStackLayout Grid.Column="0" Spacing="12" VerticalOptions="Center">
                                    <Border WidthRequest="40" HeightRequest="40" BackgroundColor="#fff7ed" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                        <Label Text="&#xe8cc;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="22" TextColor="#f97316" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Label Text="All Favorites" FontSize="16" FontAttributes="Bold" TextColor="#191c1e"/>
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding TotalFavoritesPriceText}" FontSize="18" FontAttributes="Bold" TextColor="#f97316"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                                <Button Grid.Column="1" Text="Add All to Cart" BackgroundColor="#f97316" TextColor="#ffffff" CornerRadius="12" FontSize="12" FontAttributes="Bold" HeightRequest="40" Padding="16,0" Clicked="OnBatchAddTapped"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="#ffffff" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="12" Margin="16,0,16,0">
                            <Border.Shadow>
                                <Shadow Brush="#000000" Opacity="0.04" Offset="0,4" Radius="12"/>
                            </Border.Shadow>
                            <Grid RowDefinitions="Auto, *" RowSpacing="12">

                                <Border Grid.Row="0" BackgroundColor="#f2f4f6" StrokeShape="RoundRectangle 12" StrokeThickness="0" HeightRequest="140">
                                    <Grid>
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill"/>
                                        <Border BackgroundColor="{Binding BadgeColor}" StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="6,2" HorizontalOptions="Start" VerticalOptions="Start" Margin="8" IsVisible="{Binding HasBadge}">
                                            <Label Text="{Binding BadgeText}" FontSize="10" FontAttributes="Bold" TextColor="{Binding BadgeTextColor}"/>
                                        </Border>

                                        <Label Text="&#x2665;" FontSize="28" TextColor="#b81d27" HorizontalOptions="End" VerticalOptions="Start" Margin="10">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnFavoriteTapped" CommandParameter="{Binding .}"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1" RowDefinitions="Auto, *, Auto">
                                    <VerticalStackLayout Grid.Row="0" Spacing="2">
                                        <Label Text="{Binding Brand}" FontSize="10" FontAttributes="Bold" TextColor="#575e70" TextTransform="Uppercase" CharacterSpacing="1"/>
                                        <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="#191c1e" LineBreakMode="TailTruncation" MaxLines="2"/>
                                    </VerticalStackLayout>

                                    <Grid Grid.Row="2" ColumnDefinitions="*, Auto" VerticalOptions="End" Margin="0,8,0,0">

                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="End" Spacing="-2">
                                            <Grid IsVisible="{Binding HasOldPrice}" HorizontalOptions="Start" VerticalOptions="Center">
                                                <Label Text="{Binding OldPrice, StringFormat='${0:N2}'}" FontSize="11" TextColor="#575e70" LineBreakMode="NoWrap"/>
                                                <BoxView HeightRequest="1.5" Color="#575e70" HorizontalOptions="Fill" VerticalOptions="Center"/>
                                            </Grid>
                                            <Label Text="{Binding Price, StringFormat='${0:N2}'}" FontSize="14" FontAttributes="Bold" TextColor="#191c1e" LineBreakMode="NoWrap"/>
                                        </VerticalStackLayout>

                                        <!-- DYNAMIC ADD TO CART & QUANTITY CONTROL -->
                                        <Grid Grid.Column="1" VerticalOptions="End" HorizontalOptions="End">

                                            <Border WidthRequest="32" HeightRequest="32" BackgroundColor="#f97316" StrokeShape="RoundRectangle 12" StrokeThickness="0" VerticalOptions="End" HorizontalOptions="End" IsVisible="{Binding IsNotInCart}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnIncreaseQuantityTapped" CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Label Text="&#xe145;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="18" FontAttributes="Bold" TextColor="#ffffff" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>

                                            <Border BackgroundColor="#f97316" HeightRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0" VerticalOptions="End" HorizontalOptions="End" IsVisible="{Binding IsInCart}">
                                                <HorizontalStackLayout Spacing="8" Padding="8,0" VerticalOptions="Center">
                                                    <Label Text="&#xe15b;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="16" TextColor="#ffffff" VerticalOptions="Center">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnDecreaseQuantityTapped" CommandParameter="{Binding .}"/>
                                                        </Label.GestureRecognizers>
                                                    </Label>

                                                    <Label Text="{Binding CartQuantity}" FontSize="13" FontAttributes="Bold" TextColor="#ffffff" VerticalOptions="Center" Margin="2,0"/>

                                                    <Label Text="&#xe145;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="16" TextColor="#ffffff" VerticalOptions="Center">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnIncreaseQuantityTapped" CommandParameter="{Binding .}"/>
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                </HorizontalStackLayout>
                                            </Border>

                                        </Grid>

                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- CART SUMMARY STRIP -->
            <Border BackgroundColor="#ea580c" HeightRequest="56" Margin="16,0,16,16" StrokeShape="RoundRectangle 28" StrokeThickness="0" IsVisible="{Binding HasCartItems}" VerticalOptions="End">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNavCartTapped"/>
                </Border.GestureRecognizers>
                <Border.Shadow>
                    <Shadow Brush="#ea580c" Offset="0,4" Opacity="0.20" Radius="12" />
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Fill" Padding="6,0,6,0">

                    <Border Grid.Column="0" BackgroundColor="#f97316" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" StrokeThickness="0" VerticalOptions="Center">
                        <Label Text="{Binding UniqueCartItemCount}" FontSize="16" FontAttributes="Bold" TextColor="#ffffff" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0" Margin="0,-2,0,0">
                        <Label Text="Cart Total" FontSize="10" TextColor="#FED7AA" Margin="0,0,0,1"/>
                        <Label Text="{Binding TotalCartText}" FontSize="16" FontAttributes="Bold" TextColor="#ffffff" />
                    </VerticalStackLayout>

                    <Border Grid.Column="2" BackgroundColor="#ffffff" HeightRequest="38" Padding="14,0" StrokeShape="RoundRectangle 19" StrokeThickness="0" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="Go to Cart" FontSize="13" FontAttributes="Bold" TextColor="#ea580c" VerticalOptions="Center" />
                            <Label Text="&#xe5c8;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="18" FontAttributes="Bold" TextColor="#ea580c" VerticalOptions="Center" Margin="0,1,0,0" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Border>

        </Grid>

        <!-- 3. BOTTOM NAVBAR -->
        <Border Grid.Row="2" BackgroundColor="#ffffff" HeightRequest="60" StrokeThickness="0" StrokeShape="Rectangle">
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.05" Offset="0,-2" Radius="8"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*,*,*,*,*" Padding="0,4">
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavHomeTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#xe88a;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="24" TextColor="#575e70" HorizontalOptions="Center"/>
                    <Label Text="Home" FontSize="10" TextColor="#575e70" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavCategoriesTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#xe8b6;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="24" TextColor="#575e70" HorizontalOptions="Center"/>
                    <Label Text="Categories" FontSize="10" TextColor="#575e70" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <Grid Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavCartTapped"/>
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="&#xe8cb;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="24" TextColor="#575e70" HorizontalOptions="Center"/>
                        <Label Text="Cart" FontSize="10" TextColor="#575e70" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <Border BackgroundColor="#f97316" WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 8" StrokeThickness="0" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-4,-10,0" IsVisible="{Binding HasCartItems}">
                        <Label Text="{Binding UniqueCartItemCount}" FontSize="9" FontAttributes="Bold" TextColor="#ffffff" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavOrdersTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#xEF6E;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="24" TextColor="#575e70" HorizontalOptions="Center"/>
                    <Label Text="Orders" FontSize="10" TextColor="#575e70" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavProfileTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#xe7fd;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="24" TextColor="#f97316" HorizontalOptions="Center"/>
                    <Label Text="Profile" FontSize="10" FontAttributes="Bold" TextColor="#f97316" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>
</ContentPage>