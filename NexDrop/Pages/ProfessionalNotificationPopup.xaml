<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuickDrop.Pages.ProfessionalNotificationPopup"
             BackgroundColor="#80000000"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <!-- Modal Backdrop Grid with click outside to dismiss option -->
    <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackdropTapped"/>
        </Grid.GestureRecognizers>

        <!-- Centered Popup Card -->
        <Border x:Name="PopupCard"
                WidthRequest="340"
                MaximumWidthRequest="380"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="#FFFFFF"
                StrokeShape="RoundRectangle 24"
                StrokeThickness="1"
                Stroke="#E2E8F0"
                Padding="24,28,24,24">
            <Border.Shadow>
                <Shadow Brush="#0F172A" Offset="0,12" Opacity="0.18" Radius="28"/>
            </Border.Shadow>
            <Border.GestureRecognizers>
                <!-- Prevent backdrop click from dismissing when tapping inside the card -->
                <TapGestureRecognizer />
            </Border.GestureRecognizers>

            <VerticalStackLayout Spacing="16" HorizontalOptions="Fill">

                <!-- 1. ICON CIRCLE WITH PULSE GLOW -->
                <Grid WidthRequest="72" HeightRequest="72" HorizontalOptions="Center">
                    <!-- Outer Glow Ring -->
                    <Border x:Name="IconOuterRing"
                            WidthRequest="72"
                            HeightRequest="72"
                            StrokeShape="RoundRectangle 36"
                            StrokeThickness="0"
                            BackgroundColor="#FEF3C7"
                            Opacity="0.5"/>

                    <!-- Inner Icon Circle -->
                    <Border x:Name="IconInnerCircle"
                            WidthRequest="54"
                            HeightRequest="54"
                            StrokeShape="RoundRectangle 27"
                            StrokeThickness="0"
                            BackgroundColor="#F59E0B"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Label x:Name="IconGlyph"
                               Text="✓"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="#FFFFFF"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- 2. TITLE & MESSAGE TEXT -->
                <VerticalStackLayout Spacing="6" HorizontalOptions="Fill">
                    <Label x:Name="TitleLabel"
                           Text="Notification Title"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           HorizontalTextAlignment="Center"/>

                    <Label x:Name="MessageLabel"
                           Text="Your notification message details will appear here."
                           FontSize="13"
                           TextColor="#64748B"
                           LineHeight="1.25"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <!-- 3. ACTION BUTTONS (CONFIRM / CANCEL) -->
                <Grid x:Name="ButtonsGrid" ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,8,0,0">
                    <!-- Secondary Button (Cancel / Dismiss) -->
                    <Border x:Name="CancelButton"
                            Grid.Column="0"
                            BackgroundColor="#F1F5F9"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="0"
                            HeightRequest="46"
                            IsVisible="False">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCancelTapped"/>
                        </Border.GestureRecognizers>
                        <Label x:Name="CancelButtonText"
                               Text="Cancel"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#475569"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <!-- Primary Confirm Button -->
                    <Border x:Name="ConfirmButton"
                            Grid.Column="1"
                            BackgroundColor="#EA580C"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="0"
                            HeightRequest="46">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnConfirmTapped"/>
                        </Border.GestureRecognizers>
                        <Label x:Name="ConfirmButtonText"
                               Text="Continue"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#FFFFFF"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>

