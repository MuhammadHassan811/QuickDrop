<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:QuickDrop.Helpers"
             x:Class="QuickDrop.Pages.ProductsPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F8FAFC">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#EA580C</Color>
            <Color x:Key="PrimaryContainer">#F97316</Color>
            <Color x:Key="PrimaryFixed">#FDBA74</Color>
            <Color x:Key="Surface">#F8FAFC</Color>
            <Color x:Key="SurfaceContainerLowest">#FFFFFF</Color>
            <Color x:Key="SurfaceContainerLow">#F1F5F9</Color>
            <Color x:Key="SurfaceContainerHighest">#E2E8F0</Color>
            <Color x:Key="MainText">#0F172A</Color>
            <Color x:Key="SecondaryText">#64748B</Color>
            <Color x:Key="Secondary">#64748B</Color>
            <Color x:Key="Tertiary">#EF4444</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <!-- 0. TOP DELIVERY BAR -->
        <Border Grid.Row="0" BackgroundColor="#FFFFFF" StrokeThickness="1" Stroke="#F1F5F9" Padding="16,12">
            <Border.Shadow>
                <Shadow Brush="#0F172A" Offset="0,2" Opacity="0.03" Radius="10"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                <Image Grid.Column="0" Source="logo.png" HeightRequest="22" WidthRequest="72" Aspect="AspectFit" VerticalOptions="Center" />

                <Grid Grid.Column="1" ColumnDefinitions="Auto, *" ColumnSpacing="8" VerticalOptions="Center">
                    <Border Grid.Column="0" WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="#FFF7ED" VerticalOptions="Center">
                        <Label Text="&#xe55f;" FontFamily="MaterialSymbolsOutlined-Regular" TextColor="#EA580C" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="DELIVERY TO" FontSize="10" FontAttributes="Bold" TextColor="#EA580C" CharacterSpacing="0.8" />
                            <Border BackgroundColor="#ECFDF5" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="5,1">
                                <Label Text="● LIVE" FontSize="8" FontAttributes="Bold" TextColor="#10B981" />
                            </Border>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding ActiveAddressText}" FontSize="13" FontAttributes="Bold" TextColor="#0F172A" LineBreakMode="TailTruncation" MaxLines="1"/>
                            <Label Text="⌄" FontSize="14" FontAttributes="Bold" TextColor="#64748B" VerticalOptions="Center" Margin="0,-4,0,0"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center">
                    <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8FAFC" VerticalOptions="Center">
                        <Grid WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                            <Label Text="&#xe7f4;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="20" TextColor="#0F172A" HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Border BackgroundColor="#EF4444" WidthRequest="8" HeightRequest="8" StrokeShape="RoundRectangle 4" StrokeThickness="0" HorizontalOptions="End" VerticalOptions="Start" Margin="0,6,6,0"/>
                        </Grid>
                    </Border>
                    <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="1.5" Stroke="#EA580C" BackgroundColor="#F8FAFC" VerticalOptions="Center">
                        <Image x:Name="HeaderProfileImage" Source="default_avatar.png" Aspect="AspectFill" WidthRequest="36" HeightRequest="36" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- 1. CATEGORY HEADER & FILTERS -->
        <VerticalStackLayout Grid.Row="1" Spacing="12" Padding="16,12,16,10" BackgroundColor="#F8FAFC">

            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#FFFFFF" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="&#xe5c4;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="20" TextColor="#0F172A" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="12,0,0,0" Spacing="1">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label x:Name="PageTitleLabel" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                        <Border BackgroundColor="#FFF7ED" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#FDBA74" Padding="7,2" VerticalOptions="Center">
                            <Label Text="{Binding DisplayedProductCount, StringFormat='{0} items'}" FontSize="11" FontAttributes="Bold" TextColor="#EA580C" />
                        </Border>
                    </HorizontalStackLayout>
                    <Label Text="Instant Delivery • 10-15 mins" FontSize="12" TextColor="#64748B" />
                </VerticalStackLayout>

                <Border Grid.Column="2" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#FFFFFF" VerticalOptions="Center">
                    <Label Text="&#xe8b6;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="20" TextColor="#64748B" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- SEARCH BAR -->
            <Border BackgroundColor="#FFFFFF" HeightRequest="46" StrokeShape="RoundRectangle 14" StrokeThickness="1" Stroke="#E2E8F0">
                <Border.Shadow>
                    <Shadow Brush="#0F172A" Offset="0,2" Opacity="0.03" Radius="8"/>
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto, *, Auto" Padding="12,0" ColumnSpacing="10">
                    <Label Grid.Column="0" Text="&#xe8b6;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="20" TextColor="#94A3B8" VerticalOptions="Center"/>
                    <Entry x:Name="SearchEntry" Grid.Column="1" Placeholder="Search products, brands..." PlaceholderColor="#94A3B8" FontSize="14" TextColor="#0F172A" BackgroundColor="Transparent" VerticalOptions="Center" Margin="0" TextChanged="OnSearchTextChanged"/>
                    <Border Grid.Column="2" BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="6,2" VerticalOptions="Center">
                        <Label Text="⌘K" FontSize="11" FontAttributes="Bold" TextColor="#64748B" />
                    </Border>
                </Grid>
            </Border>

            <!-- HORIZONTAL CATEGORY PILLS -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="-16,0">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Categories}" Spacing="8" Padding="16,2">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{Binding BackgroundColor}" StrokeShape="RoundRectangle 20" StrokeThickness="{Binding BorderThickness}" Stroke="#E2E8F0" Padding="14,7">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                    <Label Text="✓" FontSize="13" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center" Margin="0,-1,0,0" IsVisible="{Binding IsSelected}" />
                                    <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" TextColor="{Binding TextColor}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- FILTER STRIP -->
            <Grid ColumnDefinitions="Auto, *" Padding="0,2">
                <HorizontalStackLayout Grid.Column="0" Spacing="8">
                    <Border BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#E2E8F0" Padding="10,6">
                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="&#xe164;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="16" TextColor="#EA580C" VerticalOptions="Center"/>
                            <Label Text="Best Sellers" FontSize="12" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center"/>
                            <Label Text="⌄" FontSize="13" TextColor="#64748B" VerticalOptions="Center" Margin="0,-3,0,0"/>
                        </HorizontalStackLayout>
                    </Border>
                    <Border BackgroundColor="#FFF7ED" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#FDBA74" Padding="10,6">
                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="&#xef64;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="16" TextColor="#EA580C" VerticalOptions="Center"/>
                            <Label Text="Filters" FontSize="12" FontAttributes="Bold" TextColor="#EA580C" VerticalOptions="Center"/>
                            <Border BackgroundColor="#EA580C" WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 8" StrokeThickness="0" VerticalOptions="Center">
                                <Label Text="1" FontSize="10" TextColor="#FFFFFF" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>

                <Border Grid.Column="1" HorizontalOptions="End" BackgroundColor="#FEF2F2" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#FECACA" Padding="10,6">
                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                        <Label Text="%" FontSize="13" FontAttributes="Bold" TextColor="#EF4444" VerticalOptions="Center"/>
                        <Label Text="Deals Only" FontSize="12" FontAttributes="Bold" TextColor="#EF4444" VerticalOptions="Center"/>
                        <Border BackgroundColor="#EF4444" WidthRequest="6" HeightRequest="6" StrokeShape="RoundRectangle 3" StrokeThickness="0" VerticalOptions="Center" Margin="2,0,0,0" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>

        <!-- 2. PRODUCTS GRID & FLOATING CART BAR -->
        <Grid Grid.Row="2">

            <CollectionView x:Name="ProductsCollectionView" ItemsSource="{Binding Products}" Margin="16,4,16,0">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="1" Stroke="#F1F5F9" StrokeShape="RoundRectangle 18" Padding="12" BackgroundColor="#FFFFFF">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProductTapped" />
                            </Border.GestureRecognizers>

                            <Border.Shadow>
                                <Shadow Brush="#0F172A" Offset="0,4" Opacity="0.04" Radius="14" />
                            </Border.Shadow>

                            <Grid RowDefinitions="Auto, *, Auto">
                                <!-- Image Container -->
                                <Grid Grid.Row="0" HeightRequest="130" Margin="0,0,0,10">
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="#F8FAFC">
                                        <Image Source="{Binding MainImage}" Aspect="AspectFit" Margin="6" />
                                    </Border>

                                    <!-- Discount Tag -->
                                    <Border BackgroundColor="#EF4444" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="6,2" HorizontalOptions="Start" VerticalOptions="Start" Margin="6" IsVisible="{Binding HasDiscount}">
                                        <Label Text="{Binding FormattedDiscount}" TextColor="#FFFFFF" FontSize="10" FontAttributes="Bold" />
                                    </Border>

                                    <!-- Favorite Button -->
                                    <Border BackgroundColor="#FFFFFF" WidthRequest="30" HeightRequest="30" StrokeThickness="1" Stroke="#E2E8F0" StrokeShape="RoundRectangle 15" HorizontalOptions="End" VerticalOptions="Start" Margin="6">
                                        <Border.Shadow>
                                            <Shadow Brush="#0F172A" Offset="0,2" Opacity="0.08" Radius="6"/>
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnFavoriteTapped" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding FavoriteIcon}" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Details -->
                                <VerticalStackLayout Grid.Row="1" Spacing="2">
                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <Path Data="M12,17.27 L18.18,21 L16.54,13.97 L22,9.24 L14.81,8.62 L12,2 L9.19,8.62 L2,9.24 L7.45,13.97 L5.82,21 L12,17.27 Z" Fill="#F97316" Aspect="Uniform" WidthRequest="11" HeightRequest="11" VerticalOptions="Center" />
                                        <Label Text="4.8" FontSize="11" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center"/>
                                        <Label Text="(124)" FontSize="10" TextColor="#64748B" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Brand}" FontSize="10" TextColor="#94A3B8" TextTransform="Uppercase" FontAttributes="Bold" Margin="0,2,0,0"/>
                                    <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" TextColor="#0F172A" LineBreakMode="TailTruncation" MaxLines="2" HeightRequest="36" />
                                    <Label Text="{Binding Unit}" FontSize="11" TextColor="#64748B" Margin="0,1,0,6" />
                                </VerticalStackLayout>

                                <!-- Pricing & Stepper -->
                                <Grid Grid.Row="2" ColumnDefinitions="*, Auto" VerticalOptions="End">
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="0">
                                        <Grid IsVisible="{Binding HasDiscount}" HorizontalOptions="Start" VerticalOptions="Center">
                                            <Label Text="{Binding FormattedOldPrice}" FontSize="10" TextColor="#94A3B8" TextDecorations="Strikethrough" />
                                        </Grid>
                                        <Label Text="{Binding FormattedPrice}" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                                    </VerticalStackLayout>

                                    <!-- Stepper / Add button -->
                                    <Grid Grid.Column="1" VerticalOptions="End">
                                        <Border BackgroundColor="#FFF7ED" StrokeThickness="1" Stroke="#EA580C" WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16" VerticalOptions="End" IsVisible="{Binding IsNotInCart}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnAddInitialTapped" CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <Label Text="&#xe145;" FontFamily="MaterialSymbolsOutlined-Regular" TextColor="#EA580C" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>

                                        <Border BackgroundColor="#EA580C" HeightRequest="32" StrokeThickness="0" StrokeShape="RoundRectangle 16" VerticalOptions="End" IsVisible="{Binding IsInCart}">
                                            <Grid ColumnDefinitions="28, *, 28" WidthRequest="84">
                                                <Grid Grid.Column="0" BackgroundColor="Transparent">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnDecreaseTapped" CommandParameter="{Binding .}"/>
                                                    </Grid.GestureRecognizers>
                                                    <Label Text="&#xe15b;" FontFamily="MaterialSymbolsOutlined-Regular" TextColor="#FFFFFF" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Grid>
                                                <Label Grid.Column="1" Text="{Binding CartQuantity}" TextColor="#FFFFFF" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                                <Grid Grid.Column="2" BackgroundColor="Transparent">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnIncreaseTapped" CommandParameter="{Binding .}"/>
                                                    </Grid.GestureRecognizers>
                                                    <Label Text="&#xe145;" FontFamily="MaterialSymbolsOutlined-Regular" TextColor="#FFFFFF" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <BoxView HeightRequest="90" Color="Transparent"/>
                </CollectionView.Footer>
            </CollectionView>

            <!-- FLOATING CART SUMMARY PILL -->
            <Border BackgroundColor="#EA580C" Margin="16,0,16,16" Padding="6,6,8,6" StrokeShape="RoundRectangle 28" StrokeThickness="0" IsVisible="{Binding HasCartItems}" VerticalOptions="End">
                <Border.Shadow>
                    <Shadow Brush="#0F172A" Offset="0,6" Opacity="0.25" Radius="16" />
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">

                    <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                        <Border BackgroundColor="#F97316" WidthRequest="38" HeightRequest="38" StrokeShape="RoundRectangle 19" StrokeThickness="0" VerticalOptions="Center">
                            <Label Text="{Binding UniqueCartItemCount}" FontSize="14" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="-1">
                            <Label Text="Cart Total" FontSize="10" TextColor="#FED7AA" />
                            <Label Text="{Binding TotalCartPrice, StringFormat='${0:N2}'}" FontSize="16" FontAttributes="Bold" TextColor="#FFFFFF" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Checkout button -->
                    <Border Grid.Column="2" BackgroundColor="#FFFFFF" Padding="16,8" StrokeShape="RoundRectangle 20" StrokeThickness="0" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGoToCartTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="Go to Cart" FontSize="13" FontAttributes="Bold" TextColor="#EA580C" VerticalOptions="Center" />
                            <Label Text="&#xe5c8;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="16" FontAttributes="Bold" TextColor="#EA580C" VerticalOptions="Center" Margin="0,1,0,0"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. BOTTOM NAVIGATION -->
        <Border Grid.Row="3" BackgroundColor="#FFFFFF" StrokeThickness="1" Stroke="#F1F5F9" Padding="0,8,0,14">
            <Border.Shadow>
                <Shadow Brush="#0F172A" Offset="0,-4" Opacity="0.04" Radius="16" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*, *, *, *, *" HorizontalOptions="Fill">
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavHomeTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#xe88a;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="24" TextColor="#64748B" HorizontalOptions="Center" />
                    <Label Text="Home" FontSize="10" TextColor="#64748B" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavCategoriesTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#xe8b6;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="24" TextColor="#EA580C" HorizontalOptions="Center" />
                    <Label Text="Categories" FontSize="10" FontAttributes="Bold" TextColor="#EA580C" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Grid Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavCartTapped"/>
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="&#xe8cb;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="24" TextColor="#64748B" HorizontalOptions="Center" />
                        <Label Text="Cart" FontSize="10" TextColor="#64748B" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <Border BackgroundColor="#EA580C" WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 8" StrokeThickness="0" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-2,-6,0" IsVisible="{Binding HasCartItems}">
                        <Label Text="{Binding UniqueCartItemCount}" FontSize="9" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavOrdersTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#xEF6E;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="24" TextColor="#64748B" HorizontalOptions="Center" />
                    <Label Text="Orders" FontSize="10" TextColor="#64748B" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavProfileTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#xe7fd;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="24" TextColor="#64748B" HorizontalOptions="Center" />
                    <Label Text="Profile" FontSize="10" TextColor="#64748B" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>