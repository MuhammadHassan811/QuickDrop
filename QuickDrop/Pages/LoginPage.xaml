<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuickDrop.Pages.LoginPage"
             BackgroundColor="#F8FAFC"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- NAVIGATION BAR (Header) -->
        <Grid HeightRequest="60" Padding="16,0" BackgroundColor="#FFFFFF" VerticalOptions="Start" ZIndex="10">
            <Grid.Shadow>
                <Shadow Brush="#0F172A" Opacity="0.03" Offset="0,1" Radius="8"/>
            </Grid.Shadow>

            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                <!-- Back Button and Brand -->
                <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                    <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#FFFFFF" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="&#xe5c4;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="20" TextColor="#0F172A" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <Image Source="logo.png" HeightRequest="22" WidthRequest="72" Aspect="AspectFit" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <Border Grid.Column="2" BackgroundColor="#ECFDF5" StrokeThickness="1" Stroke="#A7F3D0" StrokeShape="RoundRectangle 8" Padding="8,4" VerticalOptions="Center">
                    <Label Text="SaaS Demo" FontSize="10" FontAttributes="Bold" TextColor="#047857" />
                </Border>
            </Grid>
        </Grid>

        <!-- SCROLLABLE CONTENT -->
        <ScrollView Margin="0,60,0,0" Padding="20,24,20,32">
            <VerticalStackLayout Spacing="24">

                <!-- Welcome Headers -->
                <VerticalStackLayout Spacing="6">
                    <Border BackgroundColor="#FFF7ED" StrokeThickness="1" Stroke="#FDBA74" StrokeShape="RoundRectangle 12" Padding="10,4" HorizontalOptions="Start" Margin="0,0,0,6">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="⚡" FontSize="11" VerticalOptions="Center"/>
                            <Label Text="INSTANT ON-DEMAND DELIVERY" FontSize="10" FontAttributes="Bold" TextColor="#EA580C" VerticalOptions="Center" CharacterSpacing="0.8"/>
                        </HorizontalStackLayout>
                    </Border>
                    <Label Text="Welcome Back" FontSize="26" FontAttributes="Bold" TextColor="#0F172A"/>
                    <Label Text="Sign in to your QuickDrop workspace account" FontSize="14" TextColor="#64748B"/>
                </VerticalStackLayout>

                <!-- DEMO CREDENTIALS QUICK HINT & ROLE SELECTOR -->
                <Border BackgroundColor="#EFF6FF" StrokeShape="RoundRectangle 16" Stroke="#BFDBFE" StrokeThickness="1" Padding="14,12">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="⚡" FontSize="16" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="One-Tap Demo Credentials" FontSize="12" FontAttributes="Bold" TextColor="#1D4ED8" VerticalOptions="Center"/>
                        </Grid>
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8">
                                <Border BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 10" Stroke="#93C5FD" StrokeThickness="1" Padding="10,6">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFillCustomerLoginTapped"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="👤 Customer" FontSize="11" FontAttributes="Bold" TextColor="#1E40AF"/>
                                </Border>

                                <Border BackgroundColor="#0F172A" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10,6">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFillAdminLoginTapped"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="⚡ Super Admin" FontSize="11" FontAttributes="Bold" TextColor="#FDBA74"/>
                                </Border>

                                <Border BackgroundColor="#EA580C" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10,6">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFillVendorLoginTapped"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="🏪 Vendor" FontSize="11" FontAttributes="Bold" TextColor="#FFFFFF"/>
                                </Border>

                                <Border BackgroundColor="#0284C7" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10,6">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFillRiderLoginTapped"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="🛵 Rider" FontSize="11" FontAttributes="Bold" TextColor="#FFFFFF"/>
                                </Border>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <!-- FORM AREA -->
                <VerticalStackLayout Spacing="16">

                    <!-- Email -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email Address" FontSize="13" FontAttributes="Bold" TextColor="#0F172A"/>
                        <Border BackgroundColor="#FFFFFF" StrokeThickness="1" Stroke="#E2E8F0" StrokeShape="RoundRectangle 12" HeightRequest="50">
                            <Border.Shadow>
                                <Shadow Brush="#0F172A" Offset="0,2" Opacity="0.03" Radius="8"/>
                            </Border.Shadow>
                            <Grid ColumnDefinitions="44, *" ColumnSpacing="4">
                                <Label Grid.Column="0" Text="&#xe158;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="20" TextColor="#94A3B8" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Entry x:Name="EmailEntry" Grid.Column="1" Placeholder="demo@quickdrop.com" PlaceholderColor="#94A3B8" TextColor="#0F172A" BackgroundColor="Transparent" Keyboard="Email" VerticalOptions="Center" Margin="0,0,14,0" FontSize="14"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password" FontSize="13" FontAttributes="Bold" TextColor="#0F172A"/>
                        <Border BackgroundColor="#FFFFFF" StrokeThickness="1" Stroke="#E2E8F0" StrokeShape="RoundRectangle 12" HeightRequest="50">
                            <Border.Shadow>
                                <Shadow Brush="#0F172A" Offset="0,2" Opacity="0.03" Radius="8"/>
                            </Border.Shadow>
                            <Grid ColumnDefinitions="44, *, 44">
                                <Label Grid.Column="0" Text="&#xe897;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="20" TextColor="#94A3B8" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Entry x:Name="PasswordEntry" Grid.Column="1" IsPassword="True" Placeholder="Your password" PlaceholderColor="#94A3B8" TextColor="#0F172A" BackgroundColor="Transparent" VerticalOptions="Center" FontSize="14"/>

                                <!-- Toggle Eye Icon -->
                                <Grid Grid.Column="2" BackgroundColor="Transparent" HorizontalOptions="Fill" VerticalOptions="Fill">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTogglePasswordTapped"/>
                                    </Grid.GestureRecognizers>
                                    <Label x:Name="PasswordEyeIcon" Text="&#xe8f4;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="20" TextColor="#94A3B8" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Forgot Password -->
                        <Label Text="Forgot password?" FontSize="13" FontAttributes="Bold" TextColor="#EA580C" HorizontalOptions="End" Margin="0,4,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnForgotPasswordTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>

                    <!-- Sign In Button -->
                    <Border BackgroundColor="#EA580C" StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="50" Margin="0,4,0,0">
                        <Border.Shadow>
                            <Shadow Brush="#EA580C" Offset="0,6" Opacity="0.25" Radius="14"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLoginTapped"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="Sign In" FontSize="15" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center"/>
                            <Label Text="&#xe5c8;" FontFamily="MaterialSymbolsOutlined-Regular" FontSize="18" TextColor="#FFFFFF" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- DIVIDER -->
                <Grid Margin="0,8" VerticalOptions="Center">
                    <BoxView HeightRequest="1" Color="#E2E8F0" VerticalOptions="Center"/>
                    <Border BackgroundColor="#F8FAFC" StrokeThickness="0" HorizontalOptions="Center" Padding="14,0">
                        <Label Text="or continue with" FontSize="12" FontAttributes="Bold" TextColor="#64748B" VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- SOCIAL LOGIN BUTTONS -->
                <VerticalStackLayout Spacing="10">
                    <!-- Google -->
                    <Border BackgroundColor="#FFFFFF" StrokeThickness="1" Stroke="#E2E8F0" StrokeShape="RoundRectangle 12" HeightRequest="48">
                        <Border.Shadow>
                            <Shadow Brush="#0F172A" Offset="0,2" Opacity="0.03" Radius="8"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSocialLoginTapped"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="google_icon.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"/>
                            <Label Text="Continue with Google" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Apple -->
                    <Border BackgroundColor="#FFFFFF" StrokeThickness="1" Stroke="#E2E8F0" StrokeShape="RoundRectangle 12" HeightRequest="48">
                        <Border.Shadow>
                            <Shadow Brush="#0F172A" Offset="0,2" Opacity="0.03" Radius="8"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSocialLoginTapped"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="apple_icon.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"/>
                            <Label Text="Continue with Apple" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- SIGN UP LINK -->
                <Border BackgroundColor="#FFFFFF" StrokeThickness="1" Stroke="#F1F5F9" StrokeShape="RoundRectangle 14" Padding="16" Margin="0,8,0,0">
                    <HorizontalStackLayout Spacing="5" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="Don't have an account?" FontSize="13" TextColor="#64748B" VerticalOptions="Center"/>
                        <Label Text="Create Account" FontSize="13" FontAttributes="Bold" TextColor="#EA580C" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRegisterTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </Border>

                <!-- RIDER ONBOARDING / RECRUITMENT BANNER -->
                <Border BackgroundColor="#0F172A" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="16,12" Margin="0,4,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnJoinAsRiderTapped"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <Border Grid.Column="0" WidthRequest="38" HeightRequest="38" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 19" StrokeThickness="0" VerticalOptions="Center">
                            <Label Text="🛵" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="Want to Deliver with Us?" FontSize="13" FontAttributes="Bold" TextColor="#FFFFFF"/>
                                <Border BackgroundColor="#0369A1" StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="5,1">
                                    <Label Text="JOIN FLEET" FontSize="9" FontAttributes="Bold" TextColor="#38BDF8"/>
                                </Border>
                            </HorizontalStackLayout>
                            <Label Text="Become a QuickDrop courier &amp; earn daily" FontSize="11" TextColor="#94A3B8"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="Apply →" FontSize="12" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center"/>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>